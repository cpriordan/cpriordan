# AI Test Agent Environment Variables
# Copy this file to .env and fill in your values

# GitHub Personal Access Token (Required for private repos)
# Create at: https://github.com/settings/tokens
# Permissions needed: repo (for private repos) or public_repo (for public only)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API Key (Required for AI analysis)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
